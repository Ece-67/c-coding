#include <stdio.h>
int a[10]={ };
int top=-1;
void push(int val){
    if(top<9){
        top++;
        a[top]=val;
    }
    else{
        printf("overflow ");
    }
}
void pop(){
    if(top>=0){
        printf("%d ",a[top]);
        top--;
    }
    else{
        printf("stack is empty ");
    }
}
int main(){
    push(5);
    pop();
    return 0;
}
