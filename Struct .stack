#include <stdio.h>

struct stack {
    int a[10];
    int top;
};
void push(struct stack *st, int x) {
    if (st->top == 9){
        printf("Overflow\n");}
    else{
        st->a[++st->top] = x;}
}
void pop(struct stack *st) {
    if (st->top == -1){
        printf("Underflow\n");}
    else{
        printf("Popped: %d\n", st->a[st->top--]);}
}
int main() {
    struct stack st;
    st.top = -1;

    push(&st, 10);
    push(&st, 20);
    push(&st, 30);
    pop(&st);
    pop(&st);
    pop(&st);

    return 0;
}
