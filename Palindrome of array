#include <stdio.h>

int main() {
    int num, i = 0, a[10];
    printf("Enter number: ");
    scanf("%d", &num);
    int n = num;
    while (n) {
        a[i++] = n % 10;
        n /= 10;}
    for (int j = 0; j < i / 2; j++) {
        if (a[j] != a[i - j - 1]) {
            printf("It is not a palindrome\n");
            return 0;  
        }
    }
    printf("It is a palindrome\n");
    return 0;
}
